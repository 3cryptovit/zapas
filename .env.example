# --- app ---
APP_ENV=dev
APP_ADDR=:8080
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=debug

# --- postgres ---
# Приложение ходит в БД под ролью без BYPASSRLS (ADR-005).
DATABASE_URL=postgres://zapas_app:zapas_app@localhost:5432/zapas?sslmode=disable
MIGRATE_DATABASE_URL=postgres://zapas_owner:zapas_owner@localhost:5432/zapas?sslmode=disable
# Роль с BYPASSRLS: вход по email, разбор сессии, ночные задачи, очистка песочниц.
MAINT_DATABASE_URL=postgres://zapas_maint:zapas_maint@localhost:5432/zapas?sslmode=disable
DB_MAX_CONNS=10

# --- redis ---
REDIS_ADDR=localhost:6379

# --- session/csrf ---
SESSION_TTL=336h
SECURE_COOKIES=false

# --- notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SMTP_ADDR=localhost:1025
SMTP_FROM=zapas@example.com

# --- observability ---
SENTRY_DSN=
METRICS_ADDR=:9090

# --- sandbox ---
SANDBOX_TTL=24h
SANDBOX_MAX_ACTIVE=300
SANDBOX_PER_IP_HOURLY=5
