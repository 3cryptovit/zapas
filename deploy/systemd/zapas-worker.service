[Unit]
Description=Zapas worker (forecast, digests, outbox, cleanup)
Documentation=https://github.com/3cryptovit/zapas
After=network-online.target postgresql.service redis-server.service zapas-api.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=zapas
Group=zapas
WorkingDirectory=/srv/zapas
EnvironmentFile=/etc/zapas/zapas.env
ExecStart=/srv/zapas/bin/app worker
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zapas-worker

# Воркер считает прогноз: ему нужно чуть больше памяти, чем API.
MemoryMax=260M
CPUQuota=70%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/zapas/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
